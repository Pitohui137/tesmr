{
  "name": "salad-yook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "dev:cf": "vite build && wrangler dev",
    "dev:lan": "npx wrangler dev --port 8787 --ip $(ipconfig getifaddr en0 || ipconfig getifaddr en1)",
    "deploy:cf": "vite build && wrangler deploy",
    "deploy:prod": "bash scripts/deploy-cloudflare.sh",
    "backup:d1": "bash scripts/backup-d1.sh",
    "backup:users": "bash scripts/backup-users.sh",
    "reset:orders": "bash scripts/reset-orders.sh",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "d1:init": "wrangler d1 execute salad-yook-db --local --file=server/schema.sql && wrangler d1 execute salad-yook-db --local --file=server/seed.sql",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.23",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "hono": "^4.12.32",
    "jose": "^6.2.5",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.118.0"
  }
}
