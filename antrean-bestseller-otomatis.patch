+// Jumlah petugas yang mengerjakan pesanan secara bersamaan (barista/koki).
+// 1 = pesanan dikerjakan berurutan. Naikkan jika cafe punya beberapa petugas.
+export const KITCHEN_WORKERS = 1;
+
+const MIN = 60000;
+
 interface EstimateItem {
   menuId: string;
